<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="storage/framework/testing/phpunit"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="COMMERCE_MINIMUM_PURCHASE_KG" value="0" force="true"/>
        <server name="COMMERCE_MINIMUM_PURCHASE_KG" value="0" force="true"/>
        <env name="LOGISTICS_REQUIRE_COORDINATES" value="false" force="true"/>
        <server name="LOGISTICS_REQUIRE_COORDINATES" value="false" force="true"/>
        <env name="COMMERCE_SHOW_TEST_LABELS" value="true" force="true"/>
        <server name="COMMERCE_SHOW_TEST_LABELS" value="true" force="true"/>
        <!-- Laravel reads $_SERVER before getenv; protect both sources from inherited live settings. -->
        <server name="COMMERCE_TEST_WHATSAPP_ENABLED" value="false"/>
        <env name="COMMERCE_TEST_WHATSAPP_ENABLED" value="false" force="true"/>
        <server name="APP_ENV" value="testing"/>
        <server name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-config.php"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_DATABASE" value="agroconecta_testing"/>
        <server name="DB_URL" value=""/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/phpunit-config.php" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="agroconecta_testing" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
