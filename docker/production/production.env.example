# Copy outside the repository; preserve the same image tag for app and web.
# Always pass --env-file and -p agroconecta-production explicitly.
PROD_APP_IMAGE=agroconecta-release:rehearsal
PROD_WEB_IMAGE=agroconecta-web:rehearsal
PROD_APP_URL=https://localhost:8443
PROD_SERVER_NAME=localhost
PROD_BIND_ADDRESS=127.0.0.1
PROD_HTTP_PORT=8088
PROD_HTTPS_PORT=8443
PROD_SECRETS_DIR=/absolute/private/path/secrets
PROD_TLS_DIR=/absolute/private/path/tls

